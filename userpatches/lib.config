# Pin the Orange Pi RK3588 boards to Xunlong's vendor U-Boot 2017.09
# (branch v2017.09-rk3588), the same U-Boot Armbian ships for orangepi5pro
# (see post_family_config_branch_vendor__orangepi5pro_use_vendor_uboot in
# config/boards/orangepi5pro.csc). The rk35xx family default is Radxa's
# next-dev-v2024.10, and several boards have unguarded mainline-u-boot hooks.
#
# The framework sources this file after family and board configs (and after
# all post_family_config hooks), so these assignments take final effect.
# Defconfig names verified against the v2017.09-rk3588 branch of
# https://github.com/orangepi-xunlong/u-boot-orangepi.git.

[[ "${BRANCH}" == "vendor" ]] || return 0

case "$BOARD" in
	orangepi5) vendor_uboot_defconfig="orangepi_5_defconfig" ;;
	orangepi5b) vendor_uboot_defconfig="orangepi_5b_defconfig" ;;
	orangepi5pro) vendor_uboot_defconfig="orangepi_5_pro_defconfig" ;;
	orangepi5-max) vendor_uboot_defconfig="orangepi_5_max_defconfig" ;;
	orangepi5-plus) vendor_uboot_defconfig="orangepi_5_plus_defconfig" ;;
	*) return 0 ;; # e.g. rock-5c: no defconfig in Xunlong's tree, keep Armbian's default U-Boot
esac

BOOTSOURCE="https://github.com/orangepi-xunlong/u-boot-orangepi.git"
BOOTBRANCH="branch:v2017.09-rk3588"
BOOTPATCHDIR="legacy"
BOOTCONFIG="$vendor_uboot_defconfig"
BOOT_SCENARIO="spl-blobs"
unset vendor_uboot_defconfig

# The boards' mainline-u-boot hooks replaced the family target map with binman
# maps that only work with mainline U-Boot. Reset to the family's spl-blobs
# vendor map, including the same SPI append logic as prepare_boot_configuration.
UBOOT_TARGET_MAP="BL31=${RKBIN_DIR}/${BL31_BLOB} spl/u-boot-spl.bin u-boot.dtb u-boot.itb;;idbloader.img u-boot.itb"
if [[ "${BOOT_SUPPORT_SPI}" == "yes" ]]; then
	if [[ "${BOOT_SPI_RKSPI_LOADER:-no}" != "yes" ]]; then
		UBOOT_TARGET_MAP="${UBOOT_TARGET_MAP} tpl/u-boot-tpl.bin spl/u-boot-spl.bin u-boot.itb rkspi_loader.img"
	else
		UBOOT_TARGET_MAP="${UBOOT_TARGET_MAP} rkspi_loader.img"
	fi
fi

if [[ "$BOARD" == "orangepi5" ]]; then
	# post_family_config__orangepi5_use_mainline_uboot runs on every branch
	# and unsets uboot_custom_postprocess, which the spl-blobs flow needs to
	# produce idbloader.img / rkspi_loader.img. Restore it from the family
	# include (top-level statements in that file must not re-run).
	if [[ $(type -t uboot_custom_postprocess) != function ]]; then
		eval "$(awk '/^uboot_custom_postprocess\(\) \{/,/^\}/' "${SRC}/config/sources/families/include/rockchip64_common.inc")"
	fi
	# This per-target hook hardcodes mainline defconfig names that do not
	# exist on the 2017.09 branch; it would clobber BOOTCONFIG before make.
	# The extension dispatcher resolves hooks by name at call time, so
	# neutralize it with a no-op (unset would leave a dangling call and
	# fail with 127).
	pre_config_uboot_target__orangepi5_patch_uboot_bootconfig_hack_for_sata() { return 0; }
fi
